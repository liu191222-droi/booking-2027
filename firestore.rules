rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 只有透過網頁（匿名登入）連線的使用者可以讀寫下列集合（ptconfig、ptstaff、ptsched、ptmyshifts 為兼職排班）
    match /{col}/{doc} {
      allow read, write: if request.auth != null
        && col in ['bookings', 'config', 'pw', 'avail', 'sched', 'ot',
                 'ptconfig', 'ptstaff', 'ptsched', 'ptmyshifts'];
    }
  }
}
